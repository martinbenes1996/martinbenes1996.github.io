---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment -%}
  Generated on every build. URLs follow the same rule as the canonical tags (no .html).
{%- endcomment -%}
{%- for p in site.html_pages %}{% unless p.sitemap == false %}
  <url>
    <loc>{{ p.url | replace: '.html', '' | absolute_url }}</loc>
  </url>
{%- endunless %}{% endfor %}
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | replace: '.html', '' | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
{%- for f in site.static_files %}{% if f.extname == '.pdf' or f.path contains '.bib.txt' %}
  <url>
    <loc>{{ f.path | absolute_url }}</loc>
  </url>
{%- endif %}{% endfor %}
</urlset>
